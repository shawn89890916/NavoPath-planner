{
  "author": "NavoPath",
  "version": "1.1.0",
  "apiVersion": 1,
  "minAppVersion": "1.5.0",
  "platforms": [
    "desktop",
    "web",
    "mobile"
  ],
  "repository": "https://github.com/shawn89890916/NavoPath-planner",
  "license": "MIT",
  "kind": "theme",
  "styles": "styles.css",
  "preview": "preview-light.png",
  "id": "minimal",
  "name": "Minimal",
  "description": "Crisp neutral paper and slate ink with a restrained, distraction-free light and dark palette.",
  "options": [
    {
      "key": "paper",
      "label": "Light paper",
      "type": "color",
      "variable": "--minimal-paper",
      "default": "#FFFFFF"
    },
    {
      "key": "ink",
      "label": "Light ink",
      "type": "color",
      "variable": "--minimal-ink",
      "default": "#25292E"
    },
    {
      "key": "dark-paper",
      "label": "Dark paper",
      "type": "color",
      "variable": "--minimal-dark-paper",
      "default": "#181B1F"
    },
    {
      "key": "dark-ink",
      "label": "Dark ink",
      "type": "color",
      "variable": "--minimal-dark-ink",
      "default": "#E2E5E9"
    }
  ],
  "previews": {
    "light": "preview-light.png",
    "dark": "preview-dark.png"
  }
}
