{
  "author": "NavoPath",
  "version": "1.1.0",
  "apiVersion": 1,
  "minAppVersion": "1.5.0",
  "platforms": [
    "desktop",
    "web",
    "mobile"
  ],
  "repository": "https://github.com/shawn89890916/NavoPath-planner",
  "license": "MIT",
  "kind": "theme",
  "styles": "styles.css",
  "preview": "preview.png",
  "id": "linen",
  "name": "Linen",
  "description": "Warm linen paper, brown ink and softly layered charcoal. Configurable paper and ink in both light and dark modes.",
  "options": [
    {
      "key": "paper",
      "label": "Light paper",
      "type": "color",
      "variable": "--linen-paper",
      "default": "#FBF7EE"
    },
    {
      "key": "ink",
      "label": "Light ink",
      "type": "color",
      "variable": "--linen-ink",
      "default": "#302A22"
    },
    {
      "key": "dark-paper",
      "label": "Dark paper",
      "type": "color",
      "variable": "--linen-dark-paper",
      "default": "#1C1B18"
    },
    {
      "key": "dark-ink",
      "label": "Dark ink",
      "type": "color",
      "variable": "--linen-dark-ink",
      "default": "#DFD9CC"
    }
  ]
}
