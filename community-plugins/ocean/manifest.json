{
  "author": "NavoPath",
  "version": "1.1.0",
  "apiVersion": 1,
  "minAppVersion": "1.5.0",
  "platforms": [
    "desktop",
    "web",
    "mobile"
  ],
  "repository": "https://github.com/shawn89890916/NavoPath-planner",
  "license": "MIT",
  "kind": "theme",
  "styles": "styles.css",
  "preview": "preview-light.png",
  "id": "ocean",
  "name": "Ocean",
  "description": "Mist-blue paper, deep navy ink and quiet steel rules, paired with a layered midnight-blue dark palette.",
  "options": [
    {
      "key": "paper",
      "label": "Light paper",
      "type": "color",
      "variable": "--ocean-paper",
      "default": "#F0F6F8"
    },
    {
      "key": "ink",
      "label": "Light ink",
      "type": "color",
      "variable": "--ocean-ink",
      "default": "#233B47"
    },
    {
      "key": "dark-paper",
      "label": "Dark paper",
      "type": "color",
      "variable": "--ocean-dark-paper",
      "default": "#1B2B34"
    },
    {
      "key": "dark-ink",
      "label": "Dark ink",
      "type": "color",
      "variable": "--ocean-dark-ink",
      "default": "#DCE8EC"
    }
  ],
  "previews": {
    "light": "preview-light.png",
    "dark": "preview-dark.png"
  }
}
